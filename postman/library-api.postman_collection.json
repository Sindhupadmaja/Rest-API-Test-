    {
      "name": "10 - Borrow Available Book",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/books/1/borrow"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.request.headers.add({key: 'Authorization', value: 'Bearer ' + pm.environment.get('token')});",
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Borrow succeeded', () => pm.expect(json.message).to.eql('Book borrowed successfully'));",
              "pm.test('Status became BORROWED', () => pm.expect(json.book.status).to.eql('BORROWED'));"
            ]
          }
        }
      ]
    },
