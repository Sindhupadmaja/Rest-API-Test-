              "const json = pm.response.json();",
              "pm.test('Count is zero', () => pm.expect(json.count).to.eql(0));",
              "pm.test('Books is empty array', () => pm.expect(json.books).to.be.an('array').and.have.length(0));"
            ]
          }
        }
      ]
    },
